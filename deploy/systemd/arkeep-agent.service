[Unit]
Description=Arkeep Backup Agent
Documentation=https://arkeep.io/docs
After=network-online.target
Wants=network-online.target
# If Docker is present, wait for it so volume discovery works on startup.
After=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/arkeep-agent --state-dir=/var/lib/arkeep-agent

# The agent runs as root: it must read every file it backs up (/etc/shadow,
# /root, database directories…) and restore files anywhere with their
# original owners and permissions. Hooks and command sources run as root too;
# only admins can set them. Docker is reachable as root without a group.
# systemd sets no HOME for a service without User=: restic needs it for its
# cache and rclone for its config (/root/.config/rclone/rclone.conf).
Environment=HOME=/root

# Environment file — copy to /etc/arkeep/agent.env (chmod 600) and fill in the
# values. The agent reads every ARKEEP_* setting from it, e.g.
# ARKEEP_LOG_LEVEL=debug. Minimum required:
#   ARKEEP_SERVER_ADDR=arkeep.example.com:9090
#   ARKEEP_AGENT_SECRET=<shared secret — must match the server>
#
# Auto-enrollment (default): on first startup the agent calls the server's HTTP
# API (port 8080, derived automatically) to obtain a signed client certificate.
# The cert is stored in /var/lib/arkeep-agent and reused on every restart.
#
# Override the enrollment HTTP address when the server is behind a reverse
# proxy (Traefik, Nginx, Caddy) — the derived http://<host>:8080 won't work:
#   ARKEEP_SERVER_HTTP_ADDR=https://arkeep.example.com
# If port 8080 is exposed directly, the default is sufficient:
#   ARKEEP_SERVER_HTTP_ADDR=http://arkeep.example.com:8080
#
# Only needed when the server uses an external cert from a non-system CA:
#   ARKEEP_GRPC_TLS_CA=/etc/arkeep/ca.crt
#
# Disable TLS (same-machine only — must also set ARKEEP_GRPC_INSECURE on server):
#   ARKEEP_GRPC_INSECURE=true
EnvironmentFile=/etc/arkeep/agent.env

Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s

StateDirectory=arkeep-agent
StateDirectoryMode=0700

# Security hardening that leaves backups and restores intact. The filesystem
# is deliberately not restricted (no ProtectSystem, ProtectHome or PrivateTmp):
# restores write anywhere, including the default /tmp/arkeep-restore, which a
# private /tmp would hide and delete when the service stops.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
