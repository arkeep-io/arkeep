# Arkeep agent configuration, read by the arkeep-agent systemd service.
#
# Fill in the two required values, then start the agent:
#   sudo systemctl start arkeep-agent
#   sudo journalctl -u arkeep-agent -f
#
# This file holds the agent secret: keep it readable by root only (0600).
# Package upgrades never overwrite it. Every ARKEEP_* setting of the agent can
# go here: see https://arkeep.io/docs/reference/agent-config/

# Required: host:port of the server's gRPC endpoint, without a scheme.
ARKEEP_SERVER_ADDR=

# Required: the shared secret set as ARKEEP_AGENT_SECRET on the server.
ARKEEP_AGENT_SECRET=

# On first start the agent enrolls over the server's HTTP API to obtain its
# client certificate, by default at http://<server host>:8080. Behind a reverse
# proxy, give the public URL instead:
#ARKEEP_SERVER_HTTP_ADDR=https://arkeep.example.com

# Only when the server's gRPC certificate comes from a private CA:
#ARKEEP_GRPC_TLS_CA=/etc/arkeep/ca.crt

# Name of the agent in Arkeep and on its snapshots (default: the hostname).
#ARKEEP_AGENT_HOSTNAME=

# debug, info, warn or error.
#ARKEEP_LOG_LEVEL=info
