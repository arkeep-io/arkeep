{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arkeep Helm chart values",
  "description": "Checked by helm install, upgrade, template and lint. Every value is described in values.yaml.",
  "type": "object",
  "definitions": {
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "pullPolicy": {
      "type": "string",
      "enum": ["Always", "IfNotPresent", "Never"]
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "quantity": {
      "type": "string",
      "description": "Kubernetes resource quantity, e.g. 10Gi."
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "$ref": "#/definitions/pullPolicy" },
        "tag": {
          "type": "string",
          "description": "Defaults to the chart's appVersion when empty."
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string" } },
        "required": ["name"]
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "description": "Must stay 1 (or 0 to stop the server): the server keeps the connected-agent registry in memory."
    },
    "config": {
      "type": "object",
      "properties": {
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        },
        "baseURL": {
          "type": "string",
          "pattern": "^(https?://.+)?$",
          "description": "External base URL, e.g. https://arkeep.example.com. Empty disables password reset emails."
        },
        "dbDriver": {
          "type": "string",
          "enum": ["sqlite", "postgres"]
        },
        "secureCookies": { "type": "boolean" },
        "updateCheck": { "type": "boolean" },
        "telemetry": { "type": "boolean" },
        "trustedProxies": {
          "type": "string",
          "description": "Comma-separated IPs/CIDRs, empty for loopback only, or \"none\"."
        },
        "httpAddr": { "type": "string", "minLength": 1 },
        "grpcAddr": { "type": "string", "minLength": 1 }
      }
    },
    "grpc": {
      "type": "object",
      "properties": {
        "tls": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "mountPath": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "secret": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string" },
        "agentSecret": { "type": "string" },
        "metricsToken": { "type": "string" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": "string" },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
        },
        "size": { "$ref": "#/definitions/quantity" },
        "mountPath": { "type": "string", "minLength": 1 }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "httpPort": { "$ref": "#/definitions/port" },
        "grpcPort": { "$ref": "#/definitions/port" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": {
                      "type": "string",
                      "enum": ["Prefix", "Exact", "ImplementationSpecific"]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": { "type": "string" },
              "hosts": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "imagePullPolicy": { "$ref": "#/definitions/pullPolicy" },
        "auth": {
          "type": "object",
          "properties": {
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string" },
            "database": { "type": "string", "minLength": 1 }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "storageClass": { "type": "string" },
            "size": { "$ref": "#/definitions/quantity" }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "externalPostgresql": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "host": { "type": "string" },
        "port": { "$ref": "#/definitions/port" },
        "database": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "sslMode": {
          "type": "string",
          "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"]
        }
      }
    },
    "resources": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "name": { "type": "string" }
      }
    }
  }
}
